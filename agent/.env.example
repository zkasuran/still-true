# Copy to .env and fill in. .env is gitignored.

# Any OpenAI-compatible chat-completions gateway (base URL ends in /v1).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=gpt-5.6-sol

# A Sanity token with Context read access (org token with Context Viewer).
# For local dev this can be omitted and the logged-in `sanity login` token is used.
# SANITY_ORGANIZATION_TOKEN=

# Optional overrides (defaults target this project's Knowledge Base):
# SANITY_PROJECT_ID=mx12urdz
# SANITY_ORG_ID=oul432e18
# SANITY_KB_ID=kbOSaaWFy5yI
